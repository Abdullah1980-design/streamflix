/* =====================================================
   URL CLEANER
===================================================== */

function cleanUrl(value) {
  if (!value || typeof value !== "string") {
    return "";
  }

  let url = value.trim();

  // Handle markdown style:
  // [https://example.com](https://example.com)

  const markdownMatch = url.match(
    /^\[([^\]]+)\]\((https?:\/\/[^)]+)\)$/
  );

  if (markdownMatch) {
    return markdownMatch[1];
  }

  // Handle simple [https://example.com]
  if (url.startsWith("[") && url.endsWith("]")) {
    url = url.slice(1, -1);
  }

  return url;
}

/* =====================================================
   HOME
===================================================== */

function Home({ search = "" }) {
  const navigate = useNavigate();

  const [movies, setMovies] = useState([]);
  const [heroMovies, setHeroMovies] = useState([]);
  const [selectedCategory, setSelectedCategory] = useState("All");
  const [heroIndex, setHeroIndex] = useState(0);

  /* ===================================================
     LOAD MOVIES
  =================================================== */

  useEffect(() => {
    let active = true;

    async function loadMovies() {
      try {
        const response = await axios.get(TRENDING_API, {
          timeout: 8000,
        });

        if (
          active &&
          Array.isArray(response.data) &&
          response.data.length > 0
        ) {
          const latest = response.data;

          setMovies(latest);

          const heroes = latest.slice(0, 3).map((movie) => ({
            ...movie,
            background:
              cleanUrl(movie?.background) ||
              cleanUrl(movie?.backdrop) ||
              cleanUrl(movie?.backdrop_path) ||
              cleanUrl(movie?.poster),
          }));

          setHeroMovies(heroes);
        }
      } catch (error) {
        console.log(
          "Trending API unavailable. Using fallback content."
        );
      }
    }

    loadMovies();

    return () => {
      active = false;
    };
  }, []);

  /* ===================================================
     HERO RESET
  =================================================== */

  useEffect(() => {
    setHeroIndex(0);
  }, [heroMovies.length]);

  /* ===================================================
     HERO AUTO SLIDER
  =================================================== */

  const totalSlides =
    heroMovies.length || heroSlides.length;

  useEffect(() => {
    if (totalSlides <= 1) {
      return undefined;
    }

    const timer = setInterval(() => {
      setHeroIndex(
        (current) => (current + 1) % totalSlides
      );
    }, 6000);

    return () => clearInterval(timer);
  }, [totalSlides]);

  /* ===================================================
     BASE CONTENT
  =================================================== */

  const displayMovies =
    movies.length > 0 ? movies : fallbackMovies;

  const allMovies = [
    ...displayMovies,
    ...extraMovies,
  ];

  /* ===================================================
     ACTIVE HERO
  =================================================== */

  const activeHero =
    heroMovies.length > 0
      ? heroMovies[heroIndex] || heroMovies[0]
      : heroSlides[heroIndex] || heroSlides[0];

  /* ===================================================
     SEARCH
  =================================================== */

  const searchValue = String(search)
    .trim()
    .toLowerCase();

  function matchesSearch(movie) {
    const title = String(
      movie?.title || ""
    ).toLowerCase();

    return title.includes(searchValue);
  }

  /* ===================================================
     CATEGORY FILTER
  =================================================== */

  function matchesCategory(movie) {
    if (selectedCategory === "All") {
      return true;
    }

    const category = String(
      movie?.category ||
        movie?.genre ||
        movie?.type ||
        ""
    ).toLowerCase();

    const selected =
      selectedCategory.toLowerCase();

    if (selected === "movies") {
      return (
        !category.includes("tv") &&
        !category.includes("anime") &&
        !category.includes("sports")
      );
    }

    if (selected === "tv shows") {
      return category.includes("tv");
    }

    return category.includes(selected);
  }

  const filteredMovies = allMovies.filter(
    (movie) =>
      matchesSearch(movie) &&
      matchesCategory(movie)
  );

  /* ===================================================
     ROW FILTER
  =================================================== */

  function filterRow(list, category) {
    return list.filter((movie) => {
      if (!matchesSearch(movie)) {
        return false;
      }

      if (!category) {
        return true;
      }

      const movieCategory = String(
        movie?.category ||
          movie?.genre ||
          movie?.type ||
          ""
      ).toLowerCase();

      return movieCategory.includes(
        category.toLowerCase()
      );
    });
  }

  const trendingRow = filteredMovies;

  const popularRow = allMovies.filter(
    matchesSearch
  );

  const actionRow = filterRow(
    allMovies,
    "Action"
  );

  const dramaRow = filterRow(
    allMovies,
    "Drama"
  );

  const comedyRow = filterRow(
    allMovies,
    "Comedy"
  );

  const horrorRow = filterRow(
    allMovies,
    "Horror"
  );

  /* ===================================================
     MOVIE CLICK
  =================================================== */

  function handleMovieClick(movie) {
    if (movie?._id) {
      navigate(`/movie/${movie._id}`);
    }
  }

  /* ===================================================
     HERO BUTTONS
  =================================================== */

  function handlePlay() {
    if (activeHero?._id) {
      navigate(`/movie/${activeHero._id}`);
      return;
    }

    document
      .querySelector(".trending")
      ?.scrollIntoView({
        behavior: "smooth",
      });
  }

  function handleInfo() {
    if (activeHero?._id) {
      navigate(`/movie/${activeHero._id}`);
    } else {
      navigate("/movies");
    }
  }

  /* ===================================================
     HORIZONTAL MOVIE ROW
  =================================================== */

  function MovieRow({
    title,
    subtitle,
    moviesList,
  }) {
    if (
      !moviesList ||
      moviesList.length === 0
    ) {
      return null;
    }

    return (
      <section className="content-row">
        <div className="section-header">
          <div>
            {subtitle && (
              <div className="discover">
                {subtitle}
              </div>
            )}

            <h2>{title}</h2>
          </div>

          <button
            type="button"
            className="view-all"
            onClick={() => navigate("/movies")}
          >
            View All <b>›</b>
          </button>
        </div>

        <div className="movie-grid">
          {moviesList.map((movie, index) => (
            <article
              className="movie-card"
              key={
                movie?._id ||
                `${movie?.title}-${index}-${String(
                  title
                )}`
              }
              onClick={() =>
                handleMovieClick(movie)
              }
            >
              <div className="movie-poster">
                <img
                  src={cleanUrl(movie?.poster)}
                  alt={
                    movie?.title || "Movie"
                  }
                  loading="lazy"
                  onError={(event) => {
                    event.currentTarget.style.opacity =
                      "0";
                  }}
                />

                <div className="poster-gradient" />

                <span className="top-ten">
                  TOP 10
                </span>

                <span className="movie-rank">
                  {String(index + 1).padStart(
                    2,
                    "0"
                  )}
                </span>

                <button
                  type="button"
                  className="poster-play"
                  onClick={(event) => {
                    event.stopPropagation();
                    handleMovieClick(movie);
                  }}
                  aria-label={`Play ${
                    movie?.title || "movie"
                  }`}
                >
                  ▶
                </button>
              </div>

              <h3>
                {movie?.title || "Untitled"}
              </h3>
            </article>
          ))}
        </div>
      </section>
    );
  }

  /* ===================================================
     PREMIUM CATEGORY MOVIE ROWS
  =================================================== */

  function CategoryMovieRows() {
    return (
      <section className="category-movie-sections">
        {categoryRows.map((row) => {
          const rowMovies = displayMovies.filter(
            (movie) => {
              const category = String(
                movie?.category ||
                  movie?.genre ||
                  movie?.type ||
                  ""
              ).toLowerCase();

              return category.includes(
                row.name.toLowerCase()
              );
            }
          );

          if (rowMovies.length === 0) {
            return null;
          }

          return (
            <div
              className="category-movie-row"
              key={row.name}
            >
              {/* ROW HEADER */}

              <div className="category-row-header">
                <div className="category-row-title">
                  <span className="category-row-icon">
                    {row.icon}
                  </span>

                  <div>
                    <div className="category-row-mini">
                      STREAMFLIX COLLECTION
                    </div>

                    <h2>{row.name}</h2>
                  </div>
                </div>

                <button
                  type="button"
                  className="category-row-view"
                  onClick={() => {
                    setSelectedCategory(
                      row.name
                    );

                    window.scrollTo({
                      top: 0,
                      behavior: "smooth",
                    });
                  }}
                >
                  View All <span>›</span>
                </button>
              </div>

              {/* DESCRIPTION */}

              <p className="category-row-description">
                {row.description}
              </p>

              {/* MOVIE ROW */}

              <div className="movie-grid">
                {rowMovies.map(
                  (movie, index) => (
                    <article
                      className="movie-card"
                      key={
                        movie?._id ||
                        `${row.name}-${movie?.title}-${index}`
                      }
                      onClick={() =>
                        handleMovieClick(movie)
                      }
                    >
                      <div className="movie-poster">
                        <img
                          src={cleanUrl(
                            movie?.poster
                          )}
                          alt={
                            movie?.title ||
                            "Movie"
                          }
                          loading="lazy"
                          onError={(event) => {
                            event.currentTarget.style.opacity =
                              "0";
                          }}
                        />

                        <div className="poster-gradient" />

                        <span className="category-badge">
                          {row.name}
                        </span>

                        <button
                          type="button"
                          className="poster-play"
                          onClick={(event) => {
                            event.stopPropagation();

                            handleMovieClick(
                              movie
                            );
                          }}
                          aria-label={`Play ${
                            movie?.title ||
                            "movie"
                          }`}
                        >
                          ▶
                        </button>
                      </div>

                      <h3>
                        {movie?.title ||
                          "Untitled"}
                      </h3>
                    </article>
                  )
                )}
              </div>
            </div>
          );
        })}
      </section>
    );
  }

  /* ===================================================
     RENDER
  =================================================== */

  return (
    <main className="home-page">
      {/* =================================================
          HERO
      ================================================= */}

      <section className="hero">
        <div
          className="hero-image"
          key={cleanUrl(
            activeHero?.background
          )}
          style={{
            backgroundImage: `url("${cleanUrl(
              activeHero?.background
            )}")`,
          }}
        />

        <div className="hero-vignette" />
        <div className="hero-red-glow" />

        <div className="hero-content">
          <div className="hero-brand">
            <span>STREAM</span>
            <strong>FLIX</strong>
          </div>

          <div className="original-label">
            <i />
            A STREAMFLIX ORIGINAL
          </div>

          <h1 className="hero-title">
            {activeHero?.title ||
              "THE LAST STAND"}
          </h1>

          <div className="hero-meta">
            <span>
              {activeHero?.year || "2026"}
            </span>

            <span>
              {activeHero?.rating || "13+"}
            </span>

            <span>
              {activeHero?.genre ||
                activeHero?.category ||
                "Action"}
            </span>

            <span>
              {activeHero?.duration ||
                "2h 18m"}
            </span>
          </div>

          <p className="hero-tagline">
            Unlimited Movies, Series &
            Entertainment
          </p>

          <p className="hero-description">
            {activeHero?.description ||
              "Discover the latest movies and shows on StreamFlix."}
          </p>

          <div className="hero-buttons">
            <button
              type="button"
              className="play-button"
              onClick={handlePlay}
            >
              <span>▶</span>
              Watch Now
            </button>

            <button
              type="button"
              className="info-button"
              onClick={handleInfo}
            >
              <span>ⓘ</span>
              More Info
            </button>
          </div>
        </div>

        {/* HERO DOTS */}

        <div className="hero-dots">
          {Array.from({
            length: totalSlides,
          }).map((_, index) => (
            <button
              type="button"
              key={index}
              className={
                heroIndex === index
                  ? "active"
                  : ""
              }
              onClick={() =>
                setHeroIndex(index)
              }
              aria-label={`Go to slide ${
                index + 1
              }`}
            />
          ))}
        </div>

        <div className="hero-scroll">
          <span />
          SCROLL TO EXPLORE
        </div>
      </section>

      {/* =================================================
          CATEGORIES
      ================================================= */}

      <section className="categories-section">
        <div className="section-container">
          <div className="section-mini-title">
            BROWSE
          </div>

          <div className="category-list">
            {categories.map((category) => (
              <button
                type="button"
                key={category.name}
                className={
                  selectedCategory ===
                  category.name
                    ? "category-card active"
                    : "category-card"
                }
                onClick={() =>
                  setSelectedCategory(
                    category.name
                  )
                }
              >
                <span className="category-icon">
                  {category.icon}
                </span>

                <span className="category-name">
                  {category.name}
                </span>
              </button>
            ))}
          </div>
        </div>
      </section>

      {/* =================================================
          CONTENT
      ================================================= */}

      <section className="trending">
        <div className="section-container">
          {/* SEARCH / CATEGORY RESULTS */}

          {searchValue ||
          selectedCategory !== "All" ? (
            <>
              <MovieRow
                title={
                  selectedCategory === "All"
                    ? "Search Results"
                    : selectedCategory
                }
                subtitle="DISCOVER"
                moviesList={filteredMovies}
              />
            </>
          ) : (
            <>
              {/* TRENDING */}

              <MovieRow
                title={
                  <>
                    Trending <span>Now</span>
                  </>
                }
                subtitle="DISCOVER"
                moviesList={trendingRow}
              />

              {/* POPULAR */}

              <MovieRow
                title={
                  <>
                    Popular <span>Movies</span>
                  </>
                }
                subtitle="STREAMFLIX"
                moviesList={popularRow}
              />

              {/* ANIME */}

              <MovieRow
                title={
                  <>
                    Anime <span>World</span>
                  </>
                }
                subtitle="EXPLORE"
                moviesList={animeMovies}
              />

              {/* SPORTS */}

              <MovieRow
                title={
                  <>
                    Sports <span>Zone</span>
                  </>
                }
                subtitle="LIVE THE MOMENT"
                moviesList={sportsMovies}
              />

              {/* TV SHOWS */}

              <MovieRow
                title={
                  <>
                    TV <span>Shows</span>
                  </>
                }
                subtitle="BINGE WATCH"
                moviesList={tvShows}
              />

              {/* ACTION */}

              <MovieRow
                title={
                  <>
                    Action <span>Hits</span>
                  </>
                }
                subtitle="ADRENALINE"
                moviesList={actionRow}
              />

              {/* DRAMA */}

              <MovieRow
                title={
                  <>
                    Drama{" "}
                    <span>Collection</span>
                  </>
                }
                subtitle="EMOTIONS"
                moviesList={dramaRow}
              />

              {/* COMEDY */}

              <MovieRow
                title={
                  <>
                    Comedy <span>Zone</span>
                  </>
                }
                subtitle="FUN & ENTERTAINMENT"
                moviesList={comedyRow}
              />

              {/* HORROR */}

              <MovieRow
                title={
                  
                    Horror <span>Nights</span>
                
                }
                subtitle="DON'T WATCH ALONE"
                moviesList={horrorRow}
             

              {/* PREMIUM CATEGORY ROWS */}

              <CategoryMovieRows />
            </>
          )}

          {/* =================================================
              NO RESULTS
          ================================================= */}

          {(searchValue ||
            selectedCategory !== "All") &&
            filteredMovies.length === 0 && (
              <div className="no-results">
                <div className="no-results-icon">
                  ⌕
                </div>

                <h3>No movies found</h3>

                <p>
                  Try searching for another
                  movie.
                </p>
              </div>
            )}

          {/* =================================================
              BOTTOM SPACE
          ================================================= */}

          {!searchValue &&
            selectedCategory === "All" && (
              <div className="home-bottom-space" />
            )}
        </div>
      </section>
    </main>
  );
}

export default Home;
