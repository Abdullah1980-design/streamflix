/* =====================================================
   STREAMFLIX — CATEGORY MOVIE COLLECTIONS
===================================================== */

.category-movie-sections {
  position: relative;

  padding: 10px 90px 100px;

  background:
    linear-gradient(
      180deg,
      #070707 0%,
      #050505 100%
    );
}

/* =====================================================
   CATEGORY ROW
===================================================== */

.category-movie-row {
  position: relative;

  margin-top: 55px;

  padding-top: 5px;
}

/* subtle red cinematic glow */

.category-movie-row::before {
  content: "";

  position: absolute;

  left: -80px;
  top: -40px;

  width: 320px;
  height: 150px;

  background:
    rgba(237, 11, 22, 0.045);

  filter: blur(75px);

  pointer-events: none;
}

/* =====================================================
   ROW HEADER
===================================================== */

.category-row-header {
  position: relative;

  z-index: 2;

  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-bottom: 7px;
}

/* =====================================================
   TITLE
===================================================== */

.category-row-title {
  display: flex;

  align-items: center;

  gap: 14px;
}

.category-row-icon {
  width: 46px;
  height: 46px;

  display: flex;

  align-items: center;
  justify-content: center;

  border:
    1px solid
    rgba(255, 255, 255, 0.08);

  border-radius: 12px;

  background:
    linear-gradient(
      145deg,
      #181818,
      #0b0b0b
    );

  font-size: 21px;

  box-shadow:
    0 8px 22px rgba(0, 0, 0, 0.35);
}

/* =====================================================
   MINI TITLE
===================================================== */

.category-row-mini {
  margin-bottom: 5px;

  color:
    rgba(255, 255, 255, 0.42);

  font-size: 9px;

  font-weight: 800;

  letter-spacing: 2.5px;

  text-transform: uppercase;
}

/* =====================================================
   CATEGORY TITLE
===================================================== */

.category-row-title h2 {
  margin: 0;

  color: #fff;

  font-size: 30px;

  line-height: 1;

  font-weight: 850;

  letter-spacing: -1px;
}

/* =====================================================
   DESCRIPTION
===================================================== */

.category-row-description {
  position: relative;

  z-index: 2;

  margin:
    0 0 20px 60px;

  color:
    rgba(255, 255, 255, 0.45);

  font-size: 13px;

  line-height: 1.5;
}

/* =====================================================
   VIEW ALL
===================================================== */

.category-row-view {
  display: flex;

  align-items: center;

  gap: 5px;

  border: none;

  background: transparent;

  color: #ed0b16;

  font-family: inherit;

  font-size: 13px;

  font-weight: 800;

  cursor: pointer;

  transition:
    transform 0.25s ease,
    opacity 0.25s ease;
}

.category-row-view:hover {
  transform: translateX(5px);

  opacity: 0.8;
}

.category-row-view span {
  font-size: 22px;

  line-height: 1;
}

/* =====================================================
   CATEGORY MOVIE ROW
   IMPORTANT: HORIZONTAL ONLY
===================================================== */

.category-movie-row .movie-grid {
  position: relative;

  z-index: 2;

  display: flex;

  flex-wrap: nowrap;

  gap: 20px;

  width: 100%;

  overflow-x: auto;
  overflow-y: hidden;

  padding:
    8px 5px 24px;

  scrollbar-width: none;

  -ms-overflow-style: none;

  scroll-behavior: smooth;

  scroll-snap-type: x proximity;
}

.category-movie-row .movie-grid::-webkit-scrollbar {
  display: none;
}

/* =====================================================
   CATEGORY CARD
===================================================== */

.category-movie-row .movie-card {
  flex:
    0 0 205px;

  width: 205px;

  min-width: 205px;

  scroll-snap-align: start;
}

/* =====================================================
   CATEGORY BADGE
===================================================== */

.category-badge {
  position: absolute;

  left: 10px;
  top: 10px;

  z-index: 4;

  padding:
    5px 8px;

  border:
    1px solid
    rgba(255, 255, 255, 0.15);

  border-radius: 5px;

  background:
    rgba(0, 0, 0, 0.62);

  color: rgba(255, 255, 255, 0.9);

  font-size: 8px;

  font-weight: 900;

  letter-spacing: 0.8px;

  backdrop-filter: blur(10px);
}

/* =====================================================
   CATEGORY CARD HOVER
===================================================== */

.category-movie-row .movie-card:hover {
  transform: translateY(-3px);
}

.category-movie-row .movie-card:hover .movie-poster {
  border-color:
    rgba(237, 11, 22, 0.75);

  box-shadow:
    0 18px 42px rgba(0, 0, 0, 0.72),
    0 0 28px rgba(237, 11, 22, 0.14);
}

/* =====================================================
   TABLET
===================================================== */

@media (max-width: 1100px) {

.home-page .movie-grid {
scroll-padding-left: 5px;
scroll-padding-right: 5px;
overscroll-behavior-x: contain;
}

/* =====================================================
   STREAMFLIX — CATEGORY ROW PREMIUM POLISH
===================================================== */

.category-movie-row .movie-card {
  position: relative;
  transform: translateZ(0);
}

.category-movie-row .movie-poster {
  isolation: isolate;
}

.category-movie-row .movie-poster::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  opacity: 0;
  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,0.08),
      transparent 28%,
      transparent 70%,
      rgba(237,11,22,0.08)
    );
  transition: opacity 0.35s ease;
  z-index: 2;
}

.category-movie-row .movie-card:hover .movie-poster::after {
  opacity: 1;
}

.category-movie-row .movie-card h3 {
  transform: translateY(0);
  transition:
    color 0.25s ease,
    transform 0.25s ease;
}

.category-movie-row .movie-card:hover h3 {
  transform: translateY(-1px);
}

.category-movie-row .movie-grid {
  scroll-padding-left: 5px;
  scroll-padding-right: 5px;
  overscroll-behavior-x: contain;
}

@media (max-width: 600px) {
  .category-movie-row .movie-grid {
    scroll-padding-left: 3px;
    scroll-padding-right: 3px;
  }
}


/* =====================================================
   STREAMFLIX — CATEGORY HEADER FINAL POLISH
===================================================== */

.category-movie-row {
  position: relative;
}

.category-row-header {
  position: relative;
  padding-bottom: 4px;
}

.category-row-title {
  min-width: 0;
}

