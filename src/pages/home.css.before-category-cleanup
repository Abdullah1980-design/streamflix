/* =====================================================
   STREAMFLIX — CATEGORY MOVIE COLLECTIONS
===================================================== */

.category-movie-sections {
  position: relative;

  padding: 10px 90px 100px;

  background:
    linear-gradient(
      180deg,
      #070707 0%,
      #050505 100%
    );
}

/* =====================================================
   CATEGORY ROW
===================================================== */

.category-movie-row {
  position: relative;

  margin-top: 55px;

  padding-top: 5px;
}

/* subtle red cinematic glow */

.category-movie-row::before {
  content: "";

  position: absolute;

  left: -80px;
  top: -40px;

  width: 320px;
  height: 150px;

  background:
    rgba(237, 11, 22, 0.045);

  filter: blur(75px);

  pointer-events: none;
}

/* =====================================================
   ROW HEADER
===================================================== */

.category-row-header {
  position: relative;

  z-index: 2;

  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-bottom: 7px;
}

/* =====================================================
   TITLE
===================================================== */

.category-row-title {
  display: flex;

  align-items: center;

  gap: 14px;
}

.category-row-icon {
  width: 46px;
  height: 46px;

  display: flex;

  align-items: center;
  justify-content: center;

  border:
    1px solid
    rgba(255, 255, 255, 0.08);

  border-radius: 12px;

  background:
    linear-gradient(
      145deg,
      #181818,
      #0b0b0b
    );

  font-size: 21px;

  box-shadow:
    0 8px 22px rgba(0, 0, 0, 0.35);
}

/* =====================================================
   MINI TITLE
===================================================== */

.category-row-mini {
  margin-bottom: 5px;

  color:
    rgba(255, 255, 255, 0.42);

  font-size: 9px;

  font-weight: 800;

  letter-spacing: 2.5px;

  text-transform: uppercase;
}

/* =====================================================
   CATEGORY TITLE
===================================================== */

.category-row-title h2 {
  margin: 0;

  color: #fff;

  font-size: 30px;

  line-height: 1;

  font-weight: 850;

  letter-spacing: -1px;
}

/* =====================================================
   DESCRIPTION
===================================================== */

.category-row-description {
  position: relative;

  z-index: 2;

  margin:
    0 0 20px 60px;

  color:
    rgba(255, 255, 255, 0.45);

  font-size: 13px;

  line-height: 1.5;
}

/* =====================================================
   VIEW ALL
===================================================== */

.category-row-view {
  display: flex;

  align-items: center;

  gap: 5px;

  border: none;

  background: transparent;

  color: #ed0b16;

  font-family: inherit;

  font-size: 13px;

  font-weight: 800;

  cursor: pointer;

  transition:
    transform 0.25s ease,
    opacity 0.25s ease;
}

.category-row-view:hover {
  transform: translateX(5px);

  opacity: 0.8;
}

.category-row-view span {
  font-size: 22px;

  line-height: 1;
}

/* =====================================================
   CATEGORY MOVIE ROW
   IMPORTANT: HORIZONTAL ONLY
===================================================== */

.category-movie-row .movie-grid {
  position: relative;

  z-index: 2;

  display: flex;

  flex-wrap: nowrap;

  gap: 20px;

  width: 100%;

  overflow-x: auto;
  overflow-y: hidden;

  padding:
    8px 5px 24px;

  scrollbar-width: none;

  -ms-overflow-style: none;

  scroll-behavior: smooth;

  scroll-snap-type: x proximity;
}

.category-movie-row .movie-grid::-webkit-scrollbar {
  display: none;
}

/* =====================================================
   CATEGORY CARD
===================================================== */

.category-movie-row .movie-card {
  flex:
    0 0 205px;

  width: 205px;

  min-width: 205px;

  scroll-snap-align: start;
}

/* =====================================================
   CATEGORY BADGE
===================================================== */

.category-badge {
  position: absolute;

  left: 10px;
  top: 10px;

  z-index: 4;

  padding:
    5px 8px;

  border:
    1px solid
    rgba(255, 255, 255, 0.15);

  border-radius: 5px;

  background:
    rgba(0, 0, 0, 0.62);

  color: rgba(255, 255, 255, 0.9);

  font-size: 8px;

  font-weight: 900;

  letter-spacing: 0.8px;

  backdrop-filter: blur(10px);
}

/* =====================================================
   CATEGORY CARD HOVER
===================================================== */

.category-movie-row .movie-card:hover {
  transform: translateY(-3px);
}

.category-movie-row .movie-card:hover .movie-poster {
  border-color:
    rgba(237, 11, 22, 0.75);

  box-shadow:
    0 18px 42px rgba(0, 0, 0, 0.72),
    0 0 28px rgba(237, 11, 22, 0.14);
}

/* =====================================================
   TABLET
===================================================== */

@media (max-width: 1100px) {

  .category-movie-sections {
    padding-left: 55px;
    padding-right: 55px;
  }

}

/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 600px) {

  .category-movie-sections {
    padding:
      5px 20px 70px;
  }

  .category-movie-row {
    margin-top: 42px;
  }

  .category-row-icon {
    width: 40px;
    height: 40px;

    font-size: 18px;

    border-radius: 10px;
  }

  .category-row-title {
    gap: 11px;
  }

  .category-row-mini {
    font-size: 8px;

    letter-spacing: 1.8px;
  }

  .category-row-title h2 {
    font-size: 24px;
  }

  .category-row-description {
    margin-left: 51px;

    margin-bottom: 17px;

    font-size: 11px;
  }

  .category-row-view {
    font-size: 11px;
  }

  .category-movie-row .movie-grid {
    gap: 14px;

    padding:
      7px 2px 20px;
  }

  .category-movie-row .movie-card {
    flex:
      0 0 155px;

    width: 155px;

    min-width: 155px;
  }

}
/* =====================================================
   CATEGORY MOVIE SECTIONS
   COMEDY / HORROR / ROMANCE / KIDS / DOCUMENTARY
===================================================== */

.category-movie-sections {
  width: 100%;
  margin-top: 20px;
  padding-bottom: 80px;
}

.category-movie-row {
  width: 100%;
  margin-bottom: 70px;
  padding: 0;
}

/* =====================================================
   CATEGORY ROW HEADER
===================================================== */

.category-row-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 10px;
}

.category-row-title {
  display: flex;
  align-items: center;
  gap: 16px;
}

.category-row-icon {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 14px;

  background:
    linear-gradient(
      145deg,
      rgba(150, 0, 0, 0.28),
      rgba(255, 255, 255, 0.04)
    );

  border: 1px solid rgba(255, 255, 255, 0.08);

  box-shadow:
    0 10px 30px rgba(0, 0, 0, 0.35);

  font-size: 24px;
}

.category-row-mini {
  margin-bottom: 4px;

  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2.5px;

  color: rgba(255, 255, 255, 0.42);
  text-transform: uppercase;
}

.category-row-header h2 {
  margin: 0;

  font-size: clamp(24px, 3vw, 34px);
  line-height: 1;

  font-weight: 800;
  letter-spacing: -0.8px;
}

.category-row-header h2::after {
  content: "";
  display: block;

  width: 38px;
  height: 3px;

  margin-top: 9px;

  border-radius: 10px;

  background: #e50914;

  box-shadow:
    0 0 14px rgba(229, 9, 20, 0.5);
}

/* =====================================================
   VIEW ALL
===================================================== */

.category-row-view {
  border: 0;
  outline: none;

  background: transparent;
  color: rgba(255, 255, 255, 0.68);

  font-size: 13px;
  font-weight: 700;

  cursor: pointer;

  display: flex;
  align-items: center;
  gap: 7px;

  padding: 10px 4px;

  transition:
    color 0.25s ease,
    transform 0.25s ease;
}

.category-row-view span {
  font-size: 24px;
  line-height: 10px;

  transition:
    transform 0.25s ease;
}

.category-row-view:hover {
  color: #fff;
  transform: translateX(3px);
}

.category-row-view:hover span {
  transform: translateX(4px);
}

/* =====================================================
   CATEGORY DESCRIPTION
===================================================== */

.category-row-description {
  margin: 0 0 22px 64px;

  color: rgba(255, 255, 255, 0.48);

  font-size: 13px;
  line-height: 1.5;
}

/* =====================================================
   HORIZONTAL MOVIE ROW
===================================================== */

.category-movie-row .movie-grid {
  display: flex;

  width: 100%;

  overflow-x: auto;
  overflow-y: hidden;

  gap: 16px;

  padding: 4px 2px 18px;

  scroll-behavior: smooth;

  scrollbar-width: none;
}

.category-movie-row .movie-grid::-webkit-scrollbar {
  display: none;
}

.category-movie-row .movie-card {
  flex: 0 0 180px;

  width: 180px;
  min-width: 180px;

  cursor: pointer;

  transition:
    transform 0.3s ease;
}

.category-movie-row .movie-card:hover {
  transform: translateY(-7px);
}

/* =====================================================
   CATEGORY POSTER
===================================================== */

.category-movie-row .movie-poster {
  position: relative;

  width: 100%;
  height: 270px;

  overflow: hidden;

  border-radius: 10px;

  background: #111;

  border: 1px solid rgba(255, 255, 255, 0.07);

  box-shadow:
    0 12px 30px rgba(0, 0, 0, 0.45);

  transition:
    border-color 0.3s ease,
    box-shadow 0.3s ease;
}

.category-movie-row .movie-card:hover .movie-poster {
  border-color: rgba(229, 9, 20, 0.55);

  box-shadow:
    0 18px 42px rgba(0, 0, 0, 0.65),
    0 0 25px rgba(229, 9, 20, 0.12);
}

.category-movie-row .movie-poster img {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  transition:
    transform 0.45s ease,
    opacity 0.3s ease;
}

.category-movie-row .movie-card:hover img {
  transform: scale(1.06);
}

/* =====================================================
   POSTER GRADIENT
===================================================== */

.category-movie-row .poster-gradient {
  position: absolute;
  inset: 0;

  pointer-events: none;

  background:
    linear-gradient(
      to top,
      rgba(0, 0, 0, 0.88) 0%,
      rgba(0, 0, 0, 0.18) 42%,
      transparent 70%
    );
}

/* =====================================================
   CATEGORY BADGE
===================================================== */

.category-badge {
  position: absolute;

  top: 10px;
  left: 10px;

  padding: 5px 9px;

  border-radius: 6px;

  background:
    rgba(229, 9, 20, 0.88);

  color: #fff;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 1px;

  text-transform: uppercase;

  box-shadow:
    0 5px 15px rgba(0, 0, 0, 0.35);
}

/* =====================================================
   POSTER PLAY
===================================================== */

.category-movie-row .poster-play {
  position: absolute;

  left: 50%;
  top: 50%;

  transform:
    translate(-50%, -50%)
    scale(0.75);

  width: 48px;
  height: 48px;

  border-radius: 50%;

  border: 1px solid rgba(255, 255, 255, 0.3);

  background:
    rgba(229, 9, 20, 0.92);

  color: #fff;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 16px;

  opacity: 0;

  cursor: pointer;

  transition:
    opacity 0.3s ease,
    transform 0.3s ease,
    background 0.3s ease;

  box-shadow:
    0 8px 25px rgba(0, 0, 0, 0.5);
}

.category-movie-row .movie-card:hover .poster-play {
  opacity: 1;

  transform:
    translate(-50%, -50%)
    scale(1);
}

.category-movie-row .poster-play:hover {
  background: #f20d18;

  transform:
    translate(-50%, -50%)
    scale(1.08);
}

/* =====================================================
   MOVIE TITLE
===================================================== */

.category-movie-row .movie-card h3 {
  margin: 11px 2px 0;

  color: rgba(255, 255, 255, 0.92);

  font-size: 14px;
  font-weight: 700;

  line-height: 1.35;

  white-space: nowrap;

  overflow: hidden;
  text-overflow: ellipsis;

  transition:
    color 0.25s ease;
}

.category-movie-row .movie-card:hover h3 {
  color: #fff;
}

